# Huawei AGC / Wallet Kit credentials
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=
HUAWEI_TOKEN_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/token
HUAWEI_ISSUER_ID=
HUAWEI_PASS_TYPE_ID=

# PEM-encoded RSA private key (registered with AGC as the pass-signing key).
# Escape newlines as \n when stored in a single env var.
WALLET_SIGNING_PRIVATE_KEY=

# Open Banking (Stitch) credentials, used by the funding route
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=

PORT=3000
