# ── Ryno-Tec NFC Pass Platform — environment variables ────────────────────────

# Server
PORT=3000
NODE_ENV=development

# SQLite database path (relative to the backend/ directory)
DB_PATH=./data/rynotec.db

# Merchant POS API key — all deduct requests must present this in X-Api-Key
MERCHANT_API_KEY=change-me-in-production

# ── Huawei AppGallery Connect (Wallet Kit) ─────────────────────────────────────
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=
HUAWEI_TOKEN_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/token
HUAWEI_ISSUER_ID=
HUAWEI_PASS_TYPE_ID=

# RSA private key for RS256 pass signing (registered in AGC as the pass key).
# In production use a KMS instead of storing the raw key here.
# Escape newlines as \n when pasting into a single-line env var.
WALLET_SIGNING_PRIVATE_KEY=

# ── Stitch (Open Banking — SA instant EFT) ────────────────────────────────────
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_BASE_URL=https://api.stitch.money
