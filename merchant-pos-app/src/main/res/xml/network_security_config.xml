<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows cleartext HTTP only to 10.0.2.2 (emulator → host loopback) and
  10.0.x.x (local LAN testing). All other traffic is HTTPS only.
  Remove the domain-config block before deploying to production.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.0.0</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
